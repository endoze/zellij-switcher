keybinds {
    locked {
        bind "Ctrl g" { SwitchToMode "normal"; }
    }
    shared_except "locked" {
        bind "Ctrl g" { SwitchToMode "locked"; }
    }
    normal {
        bind "y" {
            LaunchOrFocusPlugin "file:/Users/endoze/Projects/zellij-switcher/target/wasm32-wasip1/debug/zellij-switcher.wasm" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "locked"
        }
    }
}

load_plugins {
    "file:/Users/endoze/Projects/zellij-switcher/target/wasm32-wasip1/debug/zellij-switcher.wasm"
}

default_mode "locked"
show_startup_tips false
